# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude: backend-keuze
# claude-code = via je Claude-abonnement (lokale CLI, eenmalig `claude login`)
# api         = via API-credits met ANTHROPIC_API_KEY (nodig op Vercel)
CLAUDE_BACKEND=claude-code

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Scraping (ScrapeCreators primair, Apify fallback)
SCRAPING_PROVIDER=scrapecreators
SCRAPECREATORS_API_KEY=
APIFY_TOKEN=

# Eigen transcriptie (Whisper via Groq). Vereist lokaal: brew install yt-dlp ffmpeg
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=nl

# Cron beveiliging (Vercel Cron stuurt deze mee als Bearer)
CRON_SECRET=

# Kostenplafond-alert (EUR per maand)
COST_ALERT_EUR=20

# YouTube: cookies voor yt-dlp (omzeilt de bot-check)
YTDLP_COOKIES_FROM_BROWSER=chrome
YTDLP_SUB_LANGS=nl,nl-orig,en

# Denkdiepte per stap: low | medium | high | xhigh | max
# Lager = sneller en goedkoper, maar minder diepgang in de analyse.
CHARMAP_EFFORT=high
PLAN_EFFORT=xhigh
SCRIPT_EFFORT=xhigh
AGENT_EFFORT=high

# Maximum clips per plan (10-25). Minder vulling = goedkoper plan.
PLAN_MAX_CLIPS=15

# Wachtwoordslot op de site (leeg = open, voor lokaal)
APP_PASSWORD=
