# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Scraping (ScrapeCreators primair, Apify fallback)
SCRAPING_PROVIDER=scrapecreators
SCRAPECREATORS_API_KEY=
APIFY_TOKEN=

# Eigen transcriptie (Whisper via Groq). Vereist lokaal: brew install yt-dlp ffmpeg
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=nl

# Cron beveiliging (Vercel Cron stuurt deze mee als Bearer)
CRON_SECRET=

# Kostenplafond-alert (EUR per maand)
COST_ALERT_EUR=20

# YouTube: cookies voor yt-dlp (omzeilt de bot-check)
YTDLP_COOKIES_FROM_BROWSER=chrome
YTDLP_SUB_LANGS=nl,nl-orig,en
